# Required.
DATABASE_URL=postgres://tsuzuri:tsuzuri@localhost:5432/tsuzuri

# Daemon bind address. Keep it on loopback unless something in front of it
# handles authentication.
# HOST=127.0.0.1
# PORT=8787

# Identify yourself to the sites you poll. Keep a contact URL in here.
# USER_AGENT=tsuzuri/0.1 (+https://github.com/TakashiAihara/tsuzuri)

# Politeness and throughput.
# FETCH_TIMEOUT_MS=20000
# HOST_MIN_INTERVAL_MS=1000
# FETCH_CONCURRENCY=20
# DEFAULT_FETCH_INTERVAL_SECONDS=3600
# DEGRADE_AFTER_FAILURES=5

# Requests go to public addresses only, and every redirect hop is checked.
# Turn this on if you subscribe to a feed on your own network.
# FETCH_ALLOW_PRIVATE_TARGETS=false

# Embeddings. Off by default; the reader works fully without them.
#
# There is no default model on purpose: pgvector fixes the vector width in the
# column definition, so choosing a model commits the database to it, and
# changing it later means re-embedding everything.
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=bge-m3
# Only for models that accept a `dimensions` request parameter.
# EMBEDDING_DIMENSIONS=
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_CONCURRENCY=2
# EMBEDDING_MAX_INPUT_CHARS=8000

# Used by the CLI to find the daemon.
# TSUZURI_ENDPOINT=http://127.0.0.1:8787

# Used by the database integration tests. Unset means those tests skip.
# TSUZURI_TEST_DATABASE_URL=postgres://tsuzuri:tsuzuri@localhost:5432/tsuzuri
